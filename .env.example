# Server-only configuration
NODE_ENV=development
API_PORT=3000
# PORT=3000
FRONTEND_ORIGIN=http://localhost:4173
COOKIE_SAME_SITE=lax

# PostgreSQL and database initializer configuration
# In production, you can provide DATABASE_URL (e.g. from Neon / Supabase / Render)
# or set individual DB_* variables with DB_SSL=true.
# DATABASE_URL=postgresql://user:password@host:5432/pricelens?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pricelens
TEST_DB_NAME=pricelens_test
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password
DB_SSL=false

# Optional local notification delivery; defaults shown here use no email account.
EMAIL_TRANSPORT=jsonl
EMAIL_OUTBOX_PATH=.local/pricelens-email-outbox.jsonl

# Public browser configuration; do not put secrets in VITE_ variables.
# Leave unset when serving frontend and API from the same public origin.
VITE_API_BASE_URL=http://localhost:3000/api
