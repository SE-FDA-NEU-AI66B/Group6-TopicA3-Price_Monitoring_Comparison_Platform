# Server-only configuration
NODE_ENV=development
API_PORT=3000
FRONTEND_ORIGIN=http://localhost:4173
JWT_SECRET=replace_with_a_random_value_of_at_least_32_bytes

# PostgreSQL and database initializer configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pricelens
TEST_DB_NAME=pricelens_test
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_postgres_password

# Optional local notification delivery; defaults shown here use no email account.
EMAIL_TRANSPORT=jsonl
EMAIL_OUTBOX_PATH=.local/pricelens-email-outbox.jsonl

# Public browser configuration; do not put secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:3000/api
