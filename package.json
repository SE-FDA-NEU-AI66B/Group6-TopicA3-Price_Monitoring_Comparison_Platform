{
  "name": "pricelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm --prefix backend install && npm --prefix frontend install && npm --prefix frontend run build",
    "db:init": "npm --prefix backend run db:init",
    "start": "npm --prefix backend start",
    "test": "cd tests && node --import ./helpers/environment.js --test --test-reporter=spec"
  }
}
